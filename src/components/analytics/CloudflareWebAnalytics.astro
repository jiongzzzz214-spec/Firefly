---
/**
 * Cloudflare Web Analytics（手动 beacon 版）
 *
 * 🔴 本站目前**用不到这个组件**，别填 token。
 *
 * 原因：720620.xyz 在 Cloudflare 控制台里的 Web Analytics 已经是「自动设置」模式，
 * Cloudflare 会在边缘自动注入 beacon 并正常收数据（2026-09-12 实测 24 小时 65 PV / 26 访问）。
 * 自动注入不经过本组件；如果这里再填一个 token，页面上就会出现两个 beacon，
 * 访问量会被**重复计数**。
 *
 * 保留它的用途：万一以后自动设置失效、或站点不再走 Cloudflare 代理，
 * 可以在 Manage site 里切到「Enable with JS Snippet installation」，
 * 把 token 填进 src/config/analyticsConfig.ts 即可无缝切换。
 *
 * 为什么选它而不是 GA：免费、不需要 cookie（因此不用做同意横幅）、
 * 与本站的 Cloudflare Workers 同源。
 */
interface Props {
	token: string;
	scriptUrl?: string;
}

const {
	token,
	scriptUrl = "https://static.cloudflareinsights.com/beacon.min.js",
} = Astro.props;

// Cloudflare 官方要求 beacon 配置以 JSON 形式放在 data-cf-beacon 上
const beaconConfig = JSON.stringify({ token });
---

<script
	is:inline
	data-swup-ignore-script
	defer
	src={scriptUrl}
	data-cf-beacon={beaconConfig}
></script>
